# Copy this file to .env and enter values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side equivalents used by TanStack Start.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional. Needed only if trusted server-side code uses the admin Supabase client.
# Never prefix this key with VITE_ or expose it in browser code.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional. Used only if you add an authenticated scheduled HTTP endpoint.
# CRON_SECRET=replace-with-a-long-random-secret
# CRON_SECRET_PREVIOUS=optional-previous-secret-during-rotation
